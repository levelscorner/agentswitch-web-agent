meta {
  name: 06 Webpage.list (pages of a site)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/mcp
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
      "name": "Webpage.list",
      "arguments": { "website_id": "{{websiteSuryodaya}}", "limit": 5 }
    }
  }
}
