meta {
  name: 08 conversion_attribution (the "traffic" signal)
  type: http
  seq: 8
}

post {
  url: {{ASIND}}/api/mcp
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "tools/call",
    "params": {
      "name": "endpoint.website.conversion_attribution",
      "arguments": { "website_id": "dfca595d-4248-4b07-988f-fcfbd3f3caf1" }
    }
  }
}
